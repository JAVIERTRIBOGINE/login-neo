{
  "name": "@proteo/app-login",
  "version": "1.0.3",
  "description": "Proteo4 App Login",
  "author": {
    "name": "Proteo4 Architecture Team"
  },
  "license": "UNLICENSED",
  "keywords": [
    "proteo4",
    "app",
    "angular"
  ],
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.8.1"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "ng": "ng",
    "clean": "rimraf dist coverage",
    "clean:all": "npm run clean && rimraf node_modules package-lock.json",
    "build": "ng build --configuration production --project=login && rimraf dist/conf",
    "start": "npm run start:angular",
    "start:ci": "npm run setup:local && ng serve --project=login",
    "start:angular": "npm run setup:local && ng serve --proxy-config proxy.conf.js --project=login --port 4500",
    "start:shell": "npm run setup:local && npm --prefix ../front-app-shell start",
    "start:neo": "concurrently \"npm run start:angular\" \"npm run start:shell\"",
    "start:mfe": "npm run setup:local && ng serve --configuration production --project=login --host 0.0.0.0 --disable-host-check --port 4200 --live-reload false",
    "test:spec": "ng test --watch=false --code-coverage",
    "test:spec:watch": "ng test --code-coverage",
    "test:e2e": "start-server-and-test start:ci http://localhost:4500 \"cypress run\"",
    "test:e2e:watch": "concurrently \"ng serve\" \"cypress open\"",
    "setup:local": "node ./src/_templates/setup.js local",
    "setup:env": "node ./src/_templates/setup.js env",
    "package": "npm pack",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "proteo:execute-cli": "proteo_cli.cmd",
    "install:proteo-cli": "npm i -g @proteo/cli",
    "update:p4": "p4 update",
    "---------- CI ----------": "--------------------------------------------",
    "ci:install": "npm ci",
    "ci:build": "npm run setup:env && npm run build",
    "ci:test": "npm run test:spec",
    "ci:package": "npm run package"
  },
  "private": true,
  "lint-staged": {
    "src/**/*.{ts,js,json,scss,html}": [
      "npm run lint"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
