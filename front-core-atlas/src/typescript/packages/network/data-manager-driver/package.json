{
  "name": "@proteo/data-manager-driver",
  "version": "2.4.1",
  "description": "Proteo4 Frontend Core Library",
  "repository": {
    "type": "git",
    "url": "https://bitbucket.apps.devops.aws.bancsabadell.com/scm/p4des/front-core-monorepo.git",
    "directory": "src/utils/data-manager-driver"
  },
  "publishConfig": {
    "registry": "https://artifactory.apps.devops.aws.bancsabadell.com/artifactory/api/npm/npm-local/"
  },
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "development": "./development/index.js",
      "default": "./index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:ts",
    "build:ts": "rolldown -c rolldown.config.mjs && tsc --emitDeclarationOnly",
    "link:dev": "npm link",
    "format": "pnpm run format:eslint && pnpm run format:prettier",
    "format:eslint": "pnpm run lint:eslint -- --fix",
    "format:prettier": "prettier \"**/*.{md,html,mjs,cjs,js,json}\" --ignore-path ../../../.gitignore --write",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier",
    "lint:eslint": "eslint --quiet --color --cache --cache-location .eslintcache --ignore-path ../../../.gitignore .",
    "lint:prettier": "prettier \"**/*.{md,html,mjs,cjs,js,json}\" --ignore-path ../../../.gitignore --check",
    "clean": "rimraf \"./!(*.config).{js,mjs,cjs,js.map,ts,d.ts,d.ts.map}\" types/ test/ coverage/ development/ *.tsbuildinfo",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --changedSince master --passWithNoTests --maxWorkers=25% --silent",
    "test:full": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --passWithNoTests --maxWorkers=25%",
    "test:debug": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --maxWorkers=25% --silent"
  },
  "files": [
    "**/*.{d.ts,d.ts.map,js,js.map}",
    "!test/**",
    "!coverage/**",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@proteo/data-manager-utils": "workspace:*",
    "@proteo/event-bus": "workspace:*",
    "@proteo/logger-utils": "workspace:*",
    "@proteo/uuid-utils": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@proteo/jest-config": "workspace:*",
    "@proteo/tsconfig": "workspace:*",
    "@proteo/types": "workspace:*",
    "@types/jest": "^29.5.12",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.4",
    "@proteo/rolldown-config": "workspace:*"
  },
  "types": "types/index.d.ts",
  "directories": {
    "test": "test"
  }
}
