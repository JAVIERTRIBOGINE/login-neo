{
  "name": "@proteo/ng-bootstrap",
  "version": "3.1.6",
  "description": "Proteo4 Frontend Angular Bootstrap Library",
  "type": "module",
  "scripts": {
    "build": "ng build",
    "test": "jest",
    "test:full": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "package": "pnpm run package:pack && pnpm run package:move",
    "package:pack": "npm pack --pack-destination . ./dist",
    "package:move": "shx mkdir -p ../../../dist && shx mv ./*.tgz ../../../dist/",
    "clean": "rimraf dist .ng_build .ng_pkg_build",
    "postbuild": "node ../../../../scripts/postbuild/strip-publish-config.cjs"
  },
  "peerDependencies": {
    "@angular-architects/module-federation": "^17.0.8",
    "@angular/common": "17.3.6",
    "@angular/core": "17.3.6",
    "@angular/platform-browser-dynamic": "17.3.6",
    "@angular/router": "17.3.6",
    "@proteo/event-bus": "workspace:*",
    "@proteo/logger-utils": "workspace:*",
    "@proteo/platform": "workspace:*",
    "@proteo/types": "workspace:*"
  },
  "dependencies": {
    "tslib": "^2.6.2",
    "@proteo/config-loader": "workspace:*",
    "@proteo/data-manager": "workspace:*",
    "@proteo/ng-routing": "workspace:*"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "17.3.6",
    "@angular/compiler-cli": "17.3.6",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-preset-angular": "14.5.5",
    "ng-packagr": "^17.3.0",
    "rimraf": "^5.0.5",
    "typescript": "5.4.5"
  },
  "sideEffects": false,
  "publishConfig": {
    "directory": "./dist"
  }
}