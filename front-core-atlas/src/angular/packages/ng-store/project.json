{
  "name": "ng-store",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/angular/ng-store/src",
  "prefix": "proteo",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/lib/ng-store"],
      "options": {
        "project": "lib/angular/ng-store/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "lib/angular/ng-store/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "lib/angular/ng-store/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/ng-store"],
      "options": {
        "jestConfig": "lib/angular/ng-store/jest.config.ts",
        "maxWorkers": "%50"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "package:pack": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm pack",
        "cwd": "{workspaceRoot}/dist/lib/ng-store",
        "parallel": true
      }
    },
    "package:move": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mv ./*.tgz ../../",
        "cwd": "{workspaceRoot}/dist/lib/ng-store",
        "parallel": true
      }
    },
    "generate:doc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx typedoc --plugin typedoc-plugin-markdown",
        "cwd": "{projectRoot}",
        "parallel": true
      }
    }
  }
}
