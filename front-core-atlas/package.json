{
  "name": "@proteo/core-atlas",
  "version": "2.0.0",
  "description": "Proteo4 Frontend Core Monorepo",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://bitbucket.apps.devops.aws.bancsabadell.com/scm/p4des/front-core-atlas.git"
  },
  "author": {
    "name": "Proteo4 Architecture Team"
  },
  "license": "UNLICENSED",
  "keywords": [
    "proteo4",
    "core"
  ],
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": "24.16.0",
    "pnpm": "11.3.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint --quiet --color --cache --cache-location .eslintcache --ignore-path .gitignore .",
    "format": "eslint --fix --quiet --color --cache --cache-location .eslintcache --ignore-path .gitignore .",
    "version:add": "changeset",
    "version:bump": "changeset version && pnpm install --no-frozen-lockfile",
    "version:snapshot": "changeset version --snapshot",
    "build": "pnpm run --filter \"...[origin/main]...\" --if-present build",
    "build:all": "pnpm run -r build",
    "build:bundle": "pnpm run -r --if-present build:bundle",
    "build:ts": "pnpm run -r --if-present build:ts",
    "build:angular": "pnpm run -r --filter './src/angular/packages/**' --if-present build",
    "build:typescript": "pnpm run -r --filter './src/typescript/packages/**' --if-present build",
    "clean:install": "pnpm dlx rimraf --glob \"**/node_modules\" ./pnpm-lock.yaml && pnpm i",
    "clean": "pnpm run -r clean && pnpm dlx rimraf dist",
    "test": "pnpm run --filter \"...[origin/main]...\" test",
    "test:full": "pnpm run --filter \"...[origin/main]...\" --if-present test:full",
    "package": "pnpm -r --filter !. pack --pack-destination ./dist",
    "status": "changeset status",
    "combine-coverage": "node scripts/combine-coverage.mjs",
    "dependency:check": "check-dependency-version-consistency .",
    "dependency:fix": "check-dependency-version-consistency --fix .",
    "ci:install": "pnpm install --frozen-lockfile --yes",
    "ci:build": "pnpm run --filter \"...[origin/main]...\" --if-present build",
    "ci:test": "pnpm run test:full && pnpm run combine-coverage",
    "ci:publish": "pnpm publish -r --no-git-checks --registry=https://artifactory.apps.devops.aws.bancsabadell.com/artifactory/api/npm/npm-local/",
    "ci:dev:publish": "node dev/ci-dev-publish/snapshot-publish.mjs",
    "ci:dev:verdaccio": "npx verdaccio --config dev/verdaccio/config.yml"
  },
  "devDependencies": {
    "@angular/cli": "^17.3.6",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^19.8.1",
    "@proteo/commitlint-config": "workspace:*",
    "@proteo/eslint-config": "workspace:*",
    "@proteo/eslint-plugin-commitment": "workspace:*",
    "@proteo/eslint-plugin-versioning": "workspace:*",
    "@proteo/lint-staged-config": "workspace:*",
    "@proteo/prettier-config": "workspace:*",
    "@proteo/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "check-dependency-version-consistency": "^4.1.1",
    "date-fns": "2.29.3",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^13.3.0",
    "prettier": "^3.8.1",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "glob": "^13.0.6",
    "lcov-result-merger": "^5.0.1"
  }
}